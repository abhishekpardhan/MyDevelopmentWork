# Documentation only. The client reads process environment variables, not this file.
SF_MY_DOMAIN=https://YOUR-MY-DOMAIN.my.salesforce.com
SF_CLIENT_ID=YOUR_EXTERNAL_CLIENT_APP_CONSUMER_KEY
SF_CLIENT_SECRET=YOUR_EXTERNAL_CLIENT_APP_CONSUMER_SECRET
SF_AGENT_ID=YOUR_PUBLISHED_BOTDEFINITION_ID
SF_AGENT_TYPE=AgentforceEmployeeAgent
SF_BYPASS_USER=false
# Optional SDK-only configuration; never commit real values.
SF_SDK_SESSION_ID=YOUR_APPROVED_SDK_SESSION_TOKEN
SF_SDK_AGENT_ID=YOUR_APPROVED_SDK_AGENT_IDENTIFIER
SF_SDK_AGENT_NAME=YOUR_APPROVED_SDK_AGENT_API_NAME
